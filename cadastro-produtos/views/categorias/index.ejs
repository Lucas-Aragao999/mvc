<%# Reúne cadastro acessível e listagem das categorias disponíveis para os produtos. %>
<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Categorias</title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>
  <body>
    <h1>Categorias</h1>
    <nav><a href="/">Início</a> | <a href="/produtos">Produtos</a></nav>
    <h2>Cadastrar categoria</h2>
    <% if (erros.length) { %>
      <ul role="alert"><% for (const erro of erros) { %><li><%= erro %></li><% } %></ul>
    <% } %>
    <form method="post" action="/categorias">
      <label for="nome">Nome da categoria</label>
      <input id="nome" name="nome" type="text" value="<%= nome %>" required />
      <button type="submit">Cadastrar categoria</button>
    </form>
    <h2>Categorias cadastradas</h2>
    <% if (!categorias.length) { %><p>Nenhuma categoria cadastrada.</p><% } else { %>
      <ul><% for (const categoria of categorias) { %><li><a href="/produtos/categoria/<%= categoria.id %>"><%= categoria.nome %></a></li><% } %></ul>
    <% } %>
  </body>
</html>
